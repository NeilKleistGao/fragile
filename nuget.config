<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Local feed produced by scripts/build_dotnet_bindings.ps1 (limboai-style
    custom GodotSharp packages including the fragile GDExtension classes).
    The relative path resolves against this file, so the repo is portable.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="fragile-bindings" value=".deps/nupkgs" />
  </packageSources>
</configuration>
