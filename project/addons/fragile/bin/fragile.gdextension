[configuration]

entry_symbol = "fragile_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

windows.debug.x86_64 = "./fragile.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./fragile.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "./libfragile.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./libfragile.linux.template_release.x86_64.so"
macos.debug = "./libfragile.macos.template_debug.dylib"
macos.release = "./libfragile.macos.template_release.dylib"
