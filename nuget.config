<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Local feed produced by scripts/build_dotnet_bindings.ps1 (limboai-style
    custom GodotSharp packages including the fragile GDExtension classes).
    The relative path resolves against this file, so the repo is portable.
  -->
  <!--
    Keep the NuGet global-packages cache inside the repo: restores then never
    consult ~/.nuget/packages, so stale extractions there (the cache is keyed
    by id+version and survives rebuilds of the same version) can never shadow
    the fresh local feed again. scripts/alias_sdk_package.py keeps this cache
    clean after the Godot.* packages are rebuilt.
  -->
  <config>
    <add key="globalPackagesFolder" value=".deps/nuget-cache" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="fragile-bindings" value=".deps/nupkgs" />
  </packageSources>
  <!--
    The Godot.* packages must only ever come from the local feed: the stock
    nuget.org copies lack the fragile classes (CS0246 on FWorld etc.), and a
    stock Godot.NET.Sdk 4.7.0 cached by an earlier restore would silently win
    over the alias. scripts/alias_sdk_package.py evicts that cached copy.
  -->
  <packageSourceMapping>
    <packageSource key="fragile-bindings">
      <package pattern="Godot.NET.Sdk" />
      <package pattern="GodotSharp" />
      <package pattern="GodotSharpEditor" />
      <package pattern="Godot.SourceGenerators" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
